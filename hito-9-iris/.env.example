# Copiar a .env (cp .env.example .env) y cambiar la contraseña. El archivo .env NO se versiona.
IRIS_CONTAINER=fixture2030-iris
IRIS_PORT_SUPERSERVER=1972
IRIS_PORT_WEB=52773
IRIS_NAMESPACE=USER

# Contraseña local de _SYSTEM, SuperUser y Admin (Portal: http://localhost:52773/csp/sys/UtilHome.csp).
# Reemplaza la contraseña por defecto de la imagen (SYS). Usar una propia, no una personal.
IRIS_PASSWORD=cambiar-esta-clave
