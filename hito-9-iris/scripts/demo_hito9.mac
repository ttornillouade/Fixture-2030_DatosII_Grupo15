// Hito 9 — Demostración por bloques en el Terminal de IRIS (docker exec -it fixture2030-iris iris session IRIS)
// Copiar y ejecutar cada bloque en orden. Antes, compilar: do $system.OBJ.LoadDir("/scripts/Fixture","ck")

// ===== 0. Limpieza (permite repetir la demo) =====
do ##class(Fixture.Evento).%KillExtent(), ##class(Fixture.Partido).%KillExtent(), ##class(Fixture.Persona).%KillExtent()

// ===== A. Herencia: Jugador y Arbitro heredan de Persona (RF4) =====
set j1 = ##class(Fixture.Jugador).%New(), j1.Nombre = "Jugador 09", j1.Apellido = "Seleccion 001", j1.Nacionalidad = "URY", j1.Dorsal = 9
set a1 = ##class(Fixture.Arbitro).%New(), a1.Nombre = "Arbitro", a1.Apellido = "A01", a1.Nacionalidad = "ARG", a1.Licencia = "LIC-A01"
write "j1 es Persona: ", j1.%IsA("Fixture.Persona"), " | a1 es Persona: ", a1.%IsA("Fixture.Persona"), " | Nombre heredado: ", j1.Nombre, " / ", a1.Nombre
write "a1.%Save(): ", $system.Status.IsOK(a1.%Save()), " | id: ", a1.%Id()

// ===== B. Padre-hijo: un solo %Save del partido guarda el árbol (RF3, RF6) =====
set p = ##class(Fixture.Partido).%New(), p.Codigo = "P001"
write "Gol: ", p.RegistrarEvento("Gol", 23, j1), " | Amarilla: ", p.RegistrarEvento("TarjetaAmarilla", 31, j1), " | eventos en memoria: ", p.Eventos.Count()
write "Antes de guardar -> partido: '", p.%Id(), "' jugador: '", j1.%Id(), "'"
set sc = p.%Save()  write "p.%Save(): ", $system.Status.IsOK(sc)
write "Después -> partido: ", p.%Id(), " | jugador: ", j1.%Id(), " | eventos: ", p.Eventos.GetAt(1).%Id(), ", ", p.Eventos.GetAt(2).%Id()
// Nunca se llamó %Save() sobre los eventos ni sobre el jugador.

// ===== C. Proyección SQL: los mismos datos como tablas (RF8) =====
do ##class(%SQL.Statement).%ExecDirect(, "SELECT ID, Nombre, Apellido, Nacionalidad FROM Fixture.Persona").%Display()
do ##class(%SQL.Statement).%ExecDirect(, "SELECT e.ID, e.Partido->Codigo AS Partido, e.Minuto, e.Tipo, e.Jugador->Apellido AS Jugador FROM Fixture.Evento e ORDER BY e.Minuto").%Display()

// ===== D. Navegación: abrir por ID y recorrer referencias, sin SQL (RF7) =====
set id = p.%Id()  kill p, j1, a1
set p = ##class(Fixture.Partido).%OpenId(id)
set ev = p.Eventos.GetAt(1)  write "Primer evento: ", ev.Tipo, " minuto ", ev.Minuto, " | jugador ", ev.Jugador.Nombre, " (dorsal ", ev.Jugador.Dorsal, ")"
write "Navegación inversa -> el evento conoce su partido: ", ev.Partido.Codigo, " (estado ", ev.Partido.Estado, ")"

// ===== E. Falla controlada: falta una propiedad [Required] (RF5) =====
set x = ##class(Fixture.Jugador).%New(), x.Nombre = "Sin", x.Apellido = "Dorsal", x.Nacionalidad = "URY"
set sc = x.%Save()  write "x.%Save(): ", $system.Status.IsOK(sc), !  do $system.Status.DisplayError(sc)

// ===== F. Validación encapsulada: evento en un partido FINALIZADO (RF9) =====
set p.Estado = "FINALIZADO"  write "Estado: ", p.Estado, " | guardado: ", $system.Status.IsOK(p.%Save())
set sc = p.RegistrarEvento("Gol", 0, ev.Jugador)  do $system.Status.DisplayError(sc)
write "Eventos de P001: ", p.Eventos.Count(), " (sin cambios)"

// ===== G. Integridad: borrar un partido borra sus eventos (padre-hijo) =====
set p2 = ##class(Fixture.Partido).%New(), p2.Codigo = "P002"
write "P002 gol: ", p2.RegistrarEvento("Gol", 10, ev.Jugador), " | guardado: ", $system.Status.IsOK(p2.%Save())
set rs = ##class(%SQL.Statement).%ExecDirect(, "SELECT COUNT(*) AS n FROM Fixture.Evento")  do rs.%Next()  write "Eventos en la base: ", rs.n
set id2 = p2.%Id()  kill p2  write "Borrar P002: ", $system.Status.IsOK(##class(Fixture.Partido).%DeleteId(id2))
set rs = ##class(%SQL.Statement).%ExecDirect(, "SELECT COUNT(*) AS n FROM Fixture.Evento")  do rs.%Next()  write "Eventos en la base: ", rs.n, " (el de P002 se borró en cascada)"
