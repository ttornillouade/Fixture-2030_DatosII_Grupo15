# Copiar a .env y completar. El archivo .env NO se versiona.
TIMEOUT_S=3

MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=fixture2030

CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=fixture2030_comments

REDIS_URL=redis://localhost:6379/0

INFLUX_URL=http://localhost:8181
INFLUX_DATABASE=fixture2030_vivo
# Token de administrador: si queda vacío, scripts/inicializar_datos.sh lo crea y lo guarda acá
INFLUX_TOKEN=

IRIS_HOST=localhost
IRIS_PORT=1972
IRIS_NAMESPACE=USER
IRIS_USUARIO=_SYSTEM
# scripts/inicializar_datos.sh aplica esta contraseña al usuario _SYSTEM de IRIS
IRIS_PASSWORD=

NEO4J_URI=bolt://localhost:7687
NEO4J_USUARIO=neo4j
# Contraseña local de Neo4j (la base se crea con ella la primera vez)
NEO4J_PASSWORD=
