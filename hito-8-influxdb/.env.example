# Copiar a .env (cp .env.example .env). El archivo .env NO se versiona.
INFLUX_CONTAINER=fixture2030-influxdb
INFLUX_PORT=8181
INFLUX_NODE_ID=fixture2030-node0
INFLUX_URL=http://localhost:8181

# Bases de datos (en InfluxDB 3 "database" reemplaza a bucket/org de la v2)
INFLUX_DB_VIVO=fixture2030_vivo
INFLUX_DB_HISTORICO=fixture2030_historico

# Retención (unidades válidas: h, d, w, mo, y o "none")
INFLUX_RETENCION_VIVO=14d
INFLUX_RETENCION_HISTORICO=none

# Lo completa scripts/autorizacion.sh. No pegar tokens reales en el repositorio.
INFLUX_TOKEN=
