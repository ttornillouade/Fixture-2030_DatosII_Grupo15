# Hito 11 — configuración del diagnóstico de conectividad (sin secretos).
# Para cambiar algo: cp config/configuracion-ejemplo.env config/local.env (no se versiona) y editar.
#
# Las conexiones a las bases NO se repiten acá: se leen del mismo .env que usa la API del Hito 10,
# así el diagnóstico prueba exactamente la configuración de la aplicación.
ENV_API=../hito-10-api/.env

# API del Hito 10 y archivo donde se guarda su salida (para correlacionar requestId con el log).
API_URL=http://localhost:8000
API_LOG=docs/evidencia/api.log

# Límite de espera de cada prueba, en segundos (el mismo TIMEOUT_S de la API).
TIMEOUT_S=3

# Puertos HTTP que la API no usa pero el diagnóstico distingue: portal de Neo4j y de IRIS.
NEO4J_HTTP_URL=http://localhost:7474
IRIS_PORTAL_URL=http://localhost:52773
